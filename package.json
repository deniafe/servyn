{
  "name": "servyn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @servyn/db db:generate",
    "db:migrate": "pnpm --filter @servyn/db db:migrate",
    "db:studio": "pnpm --filter @servyn/db db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "^5",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.6.0",
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9"
  }
}
